{
  "name": "context-forge",
  "version": "4.0.1",
  "description": "Claude-current AI development context engine. Generates .claude/settings.json (hooks + MCP + statusLine + permissions), .claude/agents/, .claude/skills/, .claude/commands/ with frontmatter, plus PRPs. Ink TUI wizard, 21 slash commands across 6 subdirs, full 8-event hook lifecycle, multi-IDE (Claude, Cursor, Cline, Copilot, Windsurf, Gemini, Roo Code). Tracks Claude Opus 4.7 / Sonnet 4.6 / Haiku 4.5.",
  "main": "dist/index.js",
  "bin": {
    "context-forge": "./bin/context-forge.js"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.tui.json && node -e \"const fs=require('fs');fs.mkdirSync('dist/cli/tui',{recursive:true});fs.copyFileSync('src/cli/tui/package.json','dist/cli/tui/package.json');\"",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern='(__tests__|test).*\\.(test|spec)\\.[jt]s$' --testPathIgnorePatterns='integration.test.ts|e2e.test.ts'",
    "test:integration": "jest integration.test.ts",
    "test:e2e": "jest e2e.test.ts",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:services": "jest --testPathPattern='services.*test'",
    "test:commands": "jest --testPathPattern='commands.*test'",
    "test:prompts": "jest --testPathPattern='prompts.*test'",
    "lint": "eslint . --ext .ts,.js",
    "format": "prettier --write \"**/*.{js,ts,json,md}\"",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "keywords": [
    "claude-code",
    "claude-code-generator",
    "claude-settings-json",
    "claude-agents",
    "sub-agents",
    "claude-skills",
    "skills-md",
    "settings-json",
    "ink-tui",
    "ai-development-tools",
    "context-engineering",
    "migration-assistant",
    "tech-stack-migration",
    "human-in-the-loop",
    "claude-hooks",
    "hook-lifecycle",
    "slash-commands",
    "ai-ide",
    "project-scaffolding",
    "ai-scaffolding",
    "context-preservation",
    "developer-productivity",
    "anthropic",
    "mcp-servers",
    "cursor-ide",
    "windsurf",
    "cline",
    "github-copilot",
    "gemini-cli",
    "prp",
    "product-requirement-prompt",
    "validation-gates",
    "ai-assisted-development",
    "project-generator",
    "one-pass-implementation",
    "rollback-strategies",
    "checkpoint-system",
    "prompt-engineering",
    "ai-configuration",
    "developer-tools",
    "automation",
    "cli",
    "context-forge"
  ],
  "author": "Jason Smith <webdevtodayjason@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/webdevtodayjason/context-forge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webdevtodayjason/context-forge.git"
  },
  "bugs": {
    "url": "https://github.com/webdevtodayjason/context-forge/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=7.0.0"
  },
  "files": [
    "dist/",
    "bin/",
    "templates/",
    ".claude/docs/"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.94.0",
    "@types/uuid": "^10.0.0",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "fs-extra": "^11.3.0",
    "glob": "^11.0.3",
    "handlebars": "^4.7.8",
    "ink": "^5.0.1",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "inquirer": "^12.7.0",
    "ora": "^8.2.0",
    "react": "^18.3.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.1.138",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.12",
    "@types/react": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "jest": "^30.0.4",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-code": "^1.0.128 || ^2.1.138"
  },
  "peerDependenciesMeta": {
